<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Contoso Pizza</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🍕</text></svg>" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ContosoPizza.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark pizza-navbar mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">🍕 Contoso Pizza</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Menu">Speisekarte</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Orders">Bestellungen</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/PizzaAdmin">Verwaltung</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            @await Component.InvokeAsync("CartSummary")
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="footer-inner">
            <div class="footer-col footer-brand">
                <span class="footer-logo">🍕 Contoso Pizza</span>
                <p>
                    Pizza aussuchen, in den Warenkorb legen und bestellen –
                    eine vollständige Bestellstrecke von der Speisekarte über
                    den Warenkorb bis zur Bestellbestätigung.
                </p>
            </div>

            <div class="footer-col">
                <h3>Bestellen</h3>
                <ul>
                    <li><a asp-area="" asp-page="/Menu">Speisekarte</a></li>
                    <li><a asp-area="" asp-page="/Cart">Warenkorb</a></li>
                    <li><a asp-area="" asp-page="/Orders">Meine Bestellungen</a></li>
                    <li><a asp-area="" asp-page="/PizzaAdmin">Verwaltung</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h3>Technologie</h3>
                <ul>
                    <li>C# und .NET</li>
                    <li>ASP.NET Core Razor Pages</li>
                    <li>Entity Framework Core</li>
                    <li>Bootstrap</li>
                </ul>
            </div>

            <div class="footer-col">
                <h3>Mehr von mir</h3>
                <ul>
                    <li>
                        <a href="https://hafner312.github.io/BewerbungsPortfolio/" target="_blank" rel="noopener">
                            Portfolio-Website
                        </a>
                    </li>
                    <li>
                        <a href="https://github.com/hafner312/ContosoPizza" target="_blank" rel="noopener">
                            Quellcode auf GitHub
                        </a>
                    </li>
                    <li><a asp-area="" asp-page="/Privacy">Datenschutz</a></li>
                </ul>
            </div>
        </div>

        <div class="footer-bottom">
            <span>&copy; @DateTime.Now.Year Patrik Hafner</span>
            <span class="footer-note">
                Demo-Projekt – es werden keine echten Bestellungen ausgelöst und
                keine Zahlungsdaten verarbeitet.
            </span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
