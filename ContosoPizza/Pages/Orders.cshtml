@page
@model ContosoPizza.Pages.OrdersModel
@{
    ViewData["Title"] = "Bestellungen";
}

<div class="page-header">
    <h1>Bestellungen</h1>
    <p class="text-muted">Übersicht der zuletzt aufgegebenen Bestellungen (Demo, ohne Login).</p>
</div>

@if (Model.Orders.Count == 0)
{
    <div class="empty-state">
        <p>Noch keine Bestellungen vorhanden.</p>
        <a asp-page="/Menu" class="btn btn-pizza">Zur Speisekarte</a>
    </div>
}
else
{
    <div class="orders-list">
        @foreach (var order in Model.Orders)
        {
            <div class="order-row">
                <div class="order-row-head">
                    <strong>Bestellung #@order.Id</strong>
                    <span class="text-muted">@order.PlacedAt.ToString("dd.MM.yyyy HH:mm")</span>
                </div>
                <div class="order-row-body">
                    <span>@order.CustomerName &middot; @order.Items.Sum(i => i.Quantity) Pizza(s)</span>
                    <strong>@($"{order.Total:C}")</strong>
                </div>
            </div>
        }
    </div>
}
