@page
@model ContosoPizza.Pages.PizzaListModel
@{
    // Setzt den Titel der Seite (wird im <title>-Tag des Layouts angezeigt)
    ViewData["Title"] = "Pizza List 🍕";
}

<!-- Überschrift der Seite -->
<h1>Pizza List 🍕</h1>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group">
        <label asp-for="NewPizza.Name" class="control-label"></label>
        <input asp-for="NewPizza.Name" class="form-control" />
        <span asp-validation-for="NewPizza.Name" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="NewPizza.Size" class="control-label"></label>
        <select asp-for="NewPizza.Size" class="form-control" id="PizzaSize">
            <option value="">-- Select Size --</option>
            <option value="Small">Small</option>
            <option value="Medium">Medium</option>
            <option value="Large">Large</option>
        </select>
        <span asp-validation-for="NewPizza.Size" class="text-danger"></span>
    </div>
    <div class="form-group form-check">
        <label class="form-check-label">
            <input class="form-check-input" asp-for="NewPizza.IsGlutenFree" /> @Html.DisplayNameFor(model => model.NewPizza.IsGlutenFree)
        </label>
    </div>
    <div class="form-group">
        <label asp-for="NewPizza.Price" class="control-label"></label>
        <input asp-for="NewPizza.Price" class="form-control" />
        <span asp-validation-for="NewPizza.Price" class="text-danger"></span>
    </div>
    <div class="form-group">
        <input type="submit" value="Create" class="btn btn-primary" />
    </div>
</form>
<!--
    Die Tabelle zeigt die Pizzas aus der Datenbank an.
    Sie wird mit den Daten gefüllt, die das PageModel bereitstellt (Model.PizzaList).
-->
<table class="table mt-5">
    <thead>
        <tr>
            <!-- Spaltenüberschriften -->
            <th scope="col">Name</th>
            <th scope="col">Price</th>  
            <th scope="col">Size</th>
            <th scope="col">Gluten Free</th>
            <th scope="col">Delete</th>
        </tr>
    </thead>

    <tbody>
        @* 
            Razor foreach-Schleife:
            Sie geht durch jedes Pizza-Objekt in Model.PizzaList.
            Model = das PageModel, das du in der .cshtml.cs definiert hast.
            PizzaList = die Liste, die in OnGet() aus der Datenbank geladen wird.
        *@
        @foreach (var pizza in Model.PizzaList) 
        {
            <tr>
                <!-- Zeigt den Namen der Pizza an -->
                <td>@pizza.Name</td>

                <!--
                    Zeigt den Preis formatiert an.
                    $"{pizza.Price:C}" bedeutet: formatiere als Währung (Currency).
                -->
                <td>@($"{pizza.Price:C}")</td>

                <!-- Zeigt die Größe der Pizza an (Enum: Small/Medium/Large) -->
                <td>@pizza.Size</td>

                <!--
                    Wenn IsGlutenFree = true → ✔️ anzeigen,
                    sonst eine leere Zelle.
                    Das nennt man einen "ternären Operator".
                -->
                <td>@(pizza.IsGlutenFree ? "✔️" : string.Empty)</td>

                <!--
                    Formular zum Löschen einer Pizza.
                    method="post" → ruft OnPostDelete(...) im PageModel auf.
                    asp-route-id → übergibt die Pizza-Id an die Methode.
                -->
                <td>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@pizza.Id">
                        <button class="btn btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}