@page
@model ContosoPizza.Pages.CartModel
@{
    ViewData["Title"] = "Warenkorb";
}

<div class="page-header">
    <h1>Warenkorb</h1>
</div>

@if (Model.Lines.Count == 0)
{
    <div class="empty-state">
        <p>Dein Warenkorb ist leer.</p>
        <a asp-page="/Menu" class="btn btn-pizza">Zur Speisekarte</a>
    </div>
}
else
{
    <table class="table cart-table">
        <thead>
            <tr>
                <th>Pizza</th>
                <th>Grösse</th>
                <th>Preis</th>
                <th>Menge</th>
                <th>Zwischensumme</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in Model.Lines)
            {
                <tr>
                    <td>@ContosoPizza.Models.MenuItem.EmojiFor(line.Pizza.Name ?? "") @line.Pizza.Name</td>
                    <td>@line.Pizza.Size</td>
                    <td>@($"{line.Pizza.Price:C}")</td>
                    <td>
                        <form method="post" asp-page-handler="UpdateQuantity" class="qty-form">
                            <input type="hidden" name="pizzaId" value="@line.Pizza.Id" />
                            <input type="number" name="quantity" value="@line.Quantity" min="1" max="20" class="form-control qty-input" />
                            <button type="submit" class="btn btn-pizza-outline btn-sm">Aktualisieren</button>
                        </form>
                    </td>
                    <td>@($"{line.LineTotal:C}")</td>
                    <td>
                        <form method="post" asp-page-handler="Remove">
                            <input type="hidden" name="pizzaId" value="@line.Pizza.Id" />
                            <button type="submit" class="btn btn-danger btn-sm">Entfernen</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="cart-summary">
        <div class="cart-total">Gesamt: <strong>@($"{Model.Total:C}")</strong></div>
        <a asp-page="/Checkout" class="btn btn-pizza btn-lg">Zur Kasse</a>
    </div>
}
